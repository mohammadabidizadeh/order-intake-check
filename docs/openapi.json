{
  "openapi": "3.1.0",
  "info": {
    "title": "Order Intake Check",
    "description": "Preview one reseller order file against the process-local product mapping.",
    "version": "0.1.1"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Check process and catalog readiness",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/order-previews": {
      "post": {
        "summary": "Check an order file without creating orders",
        "operationId": "preview_orders_v1_order_previews_post",
        "requestBody": {
          "content": {
            "text/csv": {
              "schema": {
                "type": "string",
                "description": "UTF-8 CSV with header"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          },
          "400": {
            "description": "Invalid Host or interrupted upload",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "408": {
            "description": "Request Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Content Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Issue": {
        "properties": {
          "record": {
            "type": "integer",
            "title": "Record"
          },
          "field": {
            "type": "string",
            "title": "Field"
          },
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "record",
          "field",
          "code"
        ],
        "title": "Issue"
      },
      "Line": {
        "properties": {
          "line_id": {
            "type": "string",
            "title": "Line Id"
          },
          "item_code": {
            "type": "string",
            "title": "Item Code"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "line_id",
          "item_code",
          "quantity"
        ],
        "title": "Line"
      },
      "Order": {
        "properties": {
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "held"
            ],
            "title": "Status"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array",
            "title": "Lines"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "type": "array",
            "title": "Issues"
          }
        },
        "type": "object",
        "required": [
          "order_id",
          "status",
          "lines",
          "issues"
        ],
        "title": "Order"
      },
      "Preview": {
        "properties": {
          "records": {
            "type": "integer",
            "title": "Records"
          },
          "ready_orders": {
            "type": "integer",
            "title": "Ready Orders"
          },
          "held_orders": {
            "type": "integer",
            "title": "Held Orders"
          },
          "orders": {
            "items": {
              "$ref": "#/components/schemas/Order"
            },
            "type": "array",
            "title": "Orders"
          }
        },
        "type": "object",
        "required": [
          "records",
          "ready_orders",
          "held_orders",
          "orders"
        ],
        "title": "Preview"
      },
      "Problem": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "record": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Record"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "Problem"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "Token issued by the local operator.",
        "scheme": "bearer"
      }
    }
  }
}
